# Copy to config.env (untracked) and edit the settings needed.
# MODEL=/root/autodl-tmp/MAESTRO/base_models/Qwen3-8B
# STAGE1_DIR=/root/autodl-tmp/MAESTRO/environment/data/stage1
# STAGE4_DIR=/root/autodl-tmp/MAESTRO/environment/data/stage4
# RUN_ROOT=/root/autodl-tmp/MAESTRO/workspace/maestro_8b
# MAX_LENGTH=16384
# WINDOW_SIZE=128
# WINDOW_STRIDE=96
# RISK_EPOCHS=3
# RISK_BATCH_SIZE=8
# GRPO_EPOCHS=3
# DA-GRPO aligned GRPO budget (1 distinct prompt x 8 actions / optimizer update)
# GRPO_GENERATIONS=8
# GRPO_GRAD_ACCUM=1    # each MAESTRO trainer microstep ALREADY owns 8 actions
# GRPO_MAX_PROMPT_TOKENS=12288
# GRPO_MAX_NEW_TOKENS=4096
# GRPO_TEMPERATURE=1.0
# GRPO_MAX_STEPS=-1
# GRPO_ROLLOUT_ATTENTION=sdpa
# GRPO_VLLM_ENGINE=0
# GRPO_VLLM_MEMORY_UTILIZATION=0.45
# GRPO_PREFLIGHT_MAX_LOGPROB_DRIFT=0.05  # Full engine default; HF default is 0.01.
# PILOT_PROMPTS=1
# PILOT_STEPS=1
# PILOT_MAX_NEW_TOKENS=512  # DA one-step smoke uses short outputs
# SKIP_COMPLETED=1
# GRPO_RESUME_FROM=/path/to/checkpoint-100

# Cold-start rescue: optional, disabled by default
# GRPO_SFT_WARMUP=1
# GRPO_SFT_WARMUP_SAMPLES=32   # legal references selected from full Stage4 GRPO train set
# PILOT_REQUIRE_GRAD=1         # fail if rewards tie and fallback is disabled
# When warmup is enabled, PILOT_MAX_NEW_TOKENS must fit FULL reference JSON+EOS.
# PILOT_MAX_NEW_TOKENS=1536

# Stage2 self-learned output format and zero-advantage SFT fallback:
# GRPO_REWARD_MODE=curriculum        # default; strict = original -1 for every invalid Action
# GRPO_ZERO_ADV_STRATEGY=reference_sft  # default; skip = original GRPO-only behavior
# GRPO_ZERO_ADV_SFT_WEIGHT=0.25     # supervised auxiliary loss ONLY on tied-reward groups
# No forced JSON prefix, regex repair, or JSON-constrained decoding is used.
# For a short GRPO bootstrap with verified reference JSON+EOS, use 1536 output tokens
# and G=2 first, then scale back to the default G=8.
