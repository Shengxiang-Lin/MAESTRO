# Stage2 native reward selection (while retaining the working DA/TRL trainer)
# DA_REWARD_MODE=global   # default: global | hybrid | deterministic | judge_only | da
# REWARD_STATES=environment/data/stage4/private/decision_reward_states.jsonl
# Default global mode additionally reads STAGE1_DIR/questions/scenes.jsonl
# and STAGE4_DIR/private/claim_state_supervision.jsonl
# GRPO_JUDGE_WEIGHT=0.4
# GRPO_JUDGE_MODEL=qwen3.7-flash
# GRPO_JUDGE_WORKERS=4
# GRPO_JUDGE_TIMEOUT=90
# GRPO_JUDGE_RETRIES=2
# GRPO_JUDGE_CACHE_JSONL=workspace/maestro_8b/judge_cache_da_global.jsonl
# Stage2 output defaults to stage2-global-pilot/ and stage2-global-grpo/.
# Do not resume old DA 4D-reward checkpoints as if objective were unchanged.

# MAESTRO MAIN Stage2 -- DA/TRL by default; experimental RiskKV only by opt-in.
# STAGE2_TRAINER=da
# DA_DATA=/root/autodl-tmp/MAESTRO/workspace/maestro_8b/stage2_da
# DA_GRPO_CKPT=/root/autodl-tmp/MAESTRO/workspace/maestro_8b/checkpoints/stage2-da-grpo
# DA_PILOT_CKPT=/root/autodl-tmp/MAESTRO/workspace/maestro_8b/checkpoints/stage2-da-pilot
# DA_PILOT_STEPS=3
# DA_PILOT_ROWS=16
# DA_PILOT_NEW_TOKENS=1536
# DA_REVIEWED_ONLY=0
# Original DA 4D LLM Judge receives expert/gold as reward-only metadata.
# Export DASHSCOPE_API_KEY securely in the shell; do not put secrets here.
# To run old RiskKV path: STAGE2_TRAINER=riskkv

# Local-only overrides. The defaults below mirror baseline/da-grpo/config.yaml
# where compatible with frozen NF4 RiskKV training. No secrets here.
# MODEL=/root/autodl-tmp/MAESTRO/base_models/Qwen3-8B
# STAGE4_DIR=/root/autodl-tmp/MAESTRO/environment/data/stage4
# RUN_ROOT=/root/autodl-tmp/MAESTRO/workspace/maestro_8b
# MAX_LENGTH=16384
# WINDOW_SIZE=128
# WINDOW_STRIDE=96
# RISK_EPOCHS=3
# RISK_BATCH_SIZE=8

# GRPO effective batch: 1 original O1 prompt x 8 candidates per optimizer step.
# Unlike stock TRL, this custom Trainer already backprops the ENTIRE 8-candidate
# group inside one training_step, so grad_accum=1 (not DA's TRL value 8).
# GRPO_EPOCHS=3
# GRPO_MAX_STEPS=-1
# GRPO_GENERATIONS=8
# GRPO_GRAD_ACCUM=1
# GRPO_MAX_PROMPT_TOKENS=12288
# GRPO_MAX_NEW_TOKENS=4096
# GRPO_TEMPERATURE=1.0

# DA optimizer/LoRA hyperparameters applied to the existing NF4 backbone.
# GRPO_LR=5e-5
# GRPO_LORA_RANK=32
# GRPO_LORA_ALPHA=64
# GRPO_WEIGHT_DECAY=0.01
# GRPO_OPTIM=adamw_8bit
# GRPO_MAX_GRAD_NORM=1.0
# GRPO_SAVE_STEPS=50
# GRPO_LOGGING_STEPS=1

# 83 GiB RTX 6000D: enable native vLLM for multi-candidate rollout.
# MAESTRO RiskKV uses a SEPARATE vLLM BF16 worker + NF4 train model (unlike
# DA colocated engine). Therefore 0.70 may need reducing to 0.35 if OOM.
# GRPO_ROLLOUT_ATTENTION=sdpa
# GRPO_VLLM_ENGINE=1
# GRPO_VLLM_MEMORY_UTILIZATION=0.70
# GRPO_PREFLIGHT_MAX_LOGPROB_DRIFT=  # leave unset for bounded-ratio contract

# STRICT reward ONLY: invalid JSON / illegal Action => -1.
# On a tied reward group, default skip (no fabricated learning signal).
# GRPO_ZERO_ADV_STRATEGY=skip
# PILOT_REQUIRE_GRAD=1
# GRPO_SFT_WARMUP=0
# GRPO_SFT_WARMUP_SAMPLES=0   # if warmup is enabled, select ALL legal references
# GRPO_ZERO_ADV_SFT_WEIGHT=0.25  # only for explicit reference_sft ablation

# Pilot also uses the full 4096 output-token cap so valid JSON is not truncated.
# PILOT_PROMPTS=1
# PILOT_STEPS=1
# PILOT_MAX_NEW_TOKENS=4096
# SKIP_COMPLETED=1
# GRPO_RESUME_FROM=/path/to/checkpoint-50

# Optional semantic reward. Default is deterministic-only (no HTTP calls).
# Requires DASHSCOPE_API_KEY exported in the shell when mode is hybrid/judge_only.
# GRPO_REWARD_MODE=hybrid     # deterministic | hybrid | judge_only
# GRPO_JUDGE_REGISTRY=config/model_config.yaml
# GRPO_JUDGE_MODEL=qwen3.7-flash
# GRPO_JUDGE_API_KEY_ENV=DASHSCOPE_API_KEY
# GRPO_JUDGE_WORKERS=4
# GRPO_JUDGE_TIMEOUT=90
# GRPO_JUDGE_RETRIES=2
# GRPO_JUDGE_WEIGHT=0.4      # hybrid: 0.6 env + 0.4 semantic
# GRPO_JUDGE_CACHE_JSONL=workspace/maestro_8b/semantic_judge_cache.jsonl
